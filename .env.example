# Server values only. Copy to .env locally; configure these in Render Environment.
PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=paintedloops_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
# Extra allowed origins if an additional frontend is deployed separately.
FRONTEND_URLS=
# Optional email configuration; preserve working production values.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
OWNER_EMAIL=
# Optional WhatsApp configuration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
# Existing payment credentials: do not expose these through VITE_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
